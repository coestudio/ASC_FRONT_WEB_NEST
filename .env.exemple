VITE_API_URL=http://localhost:5766

# Liga as ferramentas de debug do projeto (botão de limpar cache, avisos de
# i18n no console, etc. — ver src/lib/dev-tools.ts). `true` em dev; deixar
# `false`/ausente em produção (.env.prod).
VITE_DEVELOPMENT=true

# Credenciais do botão "Super login" (src/routes/auth/login/index.tsx) — nomes
# só, valor vazio (nunca a credencial real). Botão some do form quando ausentes.
# Preencha o valor real de dev em .env.local (gitignored, por-dev), nunca aqui.
VITE_SUPER_LOGIN_USER=
VITE_SUPER_LOGIN_PASSWORD=

# Selagem do cookie de sessão httpOnly (ver specs/auth-httponly-cookie-bff.md).
# Server-only. Gerar com: openssl rand -base64 48
SESSION_SECRET=

# Base do Core para chamadas server-side / proxy (server-only, nunca no bundle).
API_URL=http://localhost:5766
