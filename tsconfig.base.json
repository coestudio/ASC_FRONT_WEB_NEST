{
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "api/*": ["./src/api/*"],
      "app/*": ["./src/app/*"],
      "assets/*": ["./src/assets/*"],
      "components/*": ["./src/components/*"],
      "config/*": ["./src/config/*"],
      "data/*": ["./src/data/*"],
      "helpers/*": ["./src/helpers/*"],
      "hooks/*": ["./src/hooks/*"],
      "i18n/*": ["./src/i18n/*"],
      "layouts/*": ["./src/layouts/*"],
      "plugins/*": ["./src/plugins/*"],
      "services/*": ["./src/services/*"],
      "styles/*": ["./src/styles/*"],
      "types/*": ["./src/types/*"],
    }
  },
  "exclude": ["node_modules"]
}