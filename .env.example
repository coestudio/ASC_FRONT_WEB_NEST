# gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Não usadas mais — login agora chama o Core de verdade (POST /api/auth/login,
# ver src/auth.ts). Mantidas comentadas só como histórico.
# AUTH_EMAIL=
# AUTH_PASSWORD_HASH=

# URL do Core (warren/Core) — usado por orval.config.ts (script de geração,
# Node puro) e pelas Server Actions (auth.ts, login/forgot-password) pra
# chamar o Core. Server-only, nunca chega no browser.
API_URL=http://localhost:5766

# Mesma URL, mas pública — usada em runtime pelo mutator dos hooks react-query
# gerados (src/api/mutator.ts), que rodam no browser (client components).
# Só existe pra esse client de leitura/dados; login/forgot-password continuam
# via Server Action com API_URL (nunca expostos ao browser).
NEXT_PUBLIC_API_URL=http://localhost:5766

# Credencial do botão "Super login" (só teste — ver TODO em login/actions.ts).
# Server-only: só o Server Action lê isso, nunca chega no client/bundle.
SUPER_LOGIN_USER=
SUPER_LOGIN_PASSWORD=
