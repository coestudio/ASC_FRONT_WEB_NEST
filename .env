VITE_API_URL=http://127.0.0.1:5766

# Liga as ferramentas de debug do projeto (botão de limpar cache, avisos de
# i18n no console, etc. — ver src/lib/dev-tools.ts). `true` em dev; deixar
# `false`/ausente em produção (.env.prod).
VITE_DEVELOPMENT=true

# Itens por página em toda listagem paginada (src/lib/page-size.ts).
VITE_PAGE_SIZE=20

# Credenciais do botão "Super login" (src/routes/auth/login/index.tsx) — só
# aparece quando as duas vars estão definidas. Nomes versionados aqui com
# valor vazio (nunca a credencial real); o valor real de dev (usuário/senha
# do SuperAdmin) vai em .env.local (gitignored, por-dev).
VITE_SUPER_LOGIN_USER=SuperAdmin
VITE_SUPER_LOGIN_PASSWORD=AGWM7ShxvKzH

# Selagem do cookie de sessão httpOnly (ver specs/auth-httponly-cookie-bff.md).
# Server-only. Gerar com: openssl rand -base64 48
SESSION_SECRET=bXJrav3h8pNp5Wd/tZMRVyhjqPB4af6tqddDHDUVzf171lFQ9ixANblP3NcyxILZ

# Base do Core para chamadas server-side / proxy (server-only, nunca no bundle).
API_URL=http://127.0.0.1:5766
